{
  "version": "2.0.0",
  "tasks": [
    {
      // label muss exakt dem preLaunchTask entsprechen
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/POIneerRender.sln",
        // or:
		    // "${workspaceFolder}/src/POIneer.Render/POIneer.Render.csproj",
        "-c", "Debug",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
