{
  "Renderer": {
    "WorkDir": "data/renderer-work-dir",
    "OutDir": "data/renderer-out-dir",
    "RegionsJson": "Cli/config/regions.production.json",
    "OnlyRegionId": "berlin"
  },
  "Publisher": {
    "DestinationDir": "data/renderer-publish-dir",
    "OverwritePolicy": "SkipIfIdentical",
    "SchemaVersion": "2"
  },
  "Flyway": {
    "Executable": "flyway",
    "ConfigFileRelativePath": "migrations/flyway-poi.toml",
    "Debug": true
  },
  "VectorTiles": {
    "Enabled": false,
    "JavaExecutablePath": "java",
    "PlanetilerJarPath": "/opt/poineer-render/tools/planetiler/planetiler.jar",
    "JavaMaxHeapSize": null,
    "Profile": null,
    "MinZoom": null,
    "MaxZoom": null,
    "AdditionalArguments": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "System": "Information",
      "POIneer.Render": "Debug"
    }
  },
  "Temp": {
    "RootFolderName": "poineer-temp",
    "KeepOnDispose": false
  }
}
